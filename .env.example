# Get the API Key from the new Doubao Speech console:
# https://console.volcengine.com/speech/new
VOLCENGINE_API_KEY=replace-with-your-api-key

# Optional: protect a public deployment with HTTP Basic Auth.
APP_USERNAME=admin
APP_PASSWORD=

# Optional server settings
HOST=127.0.0.1
PORT=3000

# Optional host port used by Docker Compose
DOCKER_PORT=3000

# Optional image override used by Docker Compose
DOUBAO_TTS_IMAGE=ghcr.io/jayhchen/doubao-tts-web:latest
